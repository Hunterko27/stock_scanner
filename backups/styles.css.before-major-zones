:root {
  --bg: #0B0E14;
  --surface: #141A24;
  --surface-2: #1C2430;
  --border: #262F3D;
  --text: #E9ECF1;
  --text-dim: #8891A3;
  --gold: #D4A94D;
  --gold-bright: #F0C878;
  --sage: #5FA37E;
  --brick: #C25B52;
  --blue: #4C7EBF;

  --font-display: 'Space Grotesk', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

/* ---------- Topbar ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  padding: 14px 20px;
  background: rgba(11, 14, 20, 0.92);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-right: auto;
}

.brand-mark {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 3px solid var(--gold);
  border-right-color: transparent;
  transform: rotate(45deg);
}

.brand-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.15rem;
  letter-spacing: 0.01em;
}

.add-form {
  display: flex;
  gap: 6px;
  flex: 1 1 260px;
  max-width: 420px;
}

.add-form input {
  flex: 1;
  min-width: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 9px 12px;
  border-radius: 8px;
  font-family: var(--font-mono);
  font-size: 0.9rem;
}

.add-form select {
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text-dim);
  border-radius: 8px;
  padding: 9px 8px;
  font-size: 0.8rem;
  font-family: var(--font-body);
}

.add-form button {
  background: var(--gold);
  color: #1a1406;
  border: none;
  border-radius: 8px;
  padding: 9px 16px;
  font-weight: 600;
  font-family: var(--font-body);
  cursor: pointer;
}

.add-form button:active { transform: translateY(1px); }

.ghost-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-dim);
  border-radius: 8px;
  padding: 9px 14px;
  cursor: pointer;
  font-family: var(--font-body);
}
.ghost-btn:hover { color: var(--text); border-color: var(--gold); }

.error-banner {
  background: rgba(194, 91, 82, 0.12);
  border-bottom: 1px solid var(--brick);
  color: var(--brick);
  font-size: 0.85rem;
  padding: 10px 20px;
  text-align: center;
}

/* ---------- Layout ---------- */
main { max-width: 1160px; margin: 0 auto; padding: 28px 20px 60px; }

.section { margin-bottom: 40px; }

.section-head { margin-bottom: 16px; }

.section-head h2 {
  font-family: var(--font-display);
  font-size: 1.3rem;
  margin: 0 0 4px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.section-tag {
  font-family: var(--font-body);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--gold);
  border: 1px solid var(--gold);
  border-radius: 20px;
  padding: 2px 9px;
  font-weight: 600;
}

.section-sub { color: var(--text-dim); font-size: 0.88rem; margin: 0; max-width: 60ch; }

.empty-note { color: var(--text-dim); font-size: 0.9rem; font-style: italic; }

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 16px;
}

/* ---------- Stock Card ---------- */
.stock-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.stock-card.golden {
  border-color: var(--gold);
  box-shadow: 0 0 0 1px var(--gold) inset, 0 0 24px -8px var(--gold-bright);
}

.stock-card.caution { border-color: var(--brick); }

.card-top { display: flex; gap: 14px; align-items: center; }

.dial-wrap { position: relative; width: 64px; height: 64px; flex-shrink: 0; }
.dial { width: 100%; height: 100%; transform: rotate(-90deg); }
.dial-track { fill: none; stroke: var(--surface-2); stroke-width: 9; }
.dial-arc {
  fill: none;
  stroke: var(--gold);
  stroke-width: 9;
  stroke-linecap: round;
  stroke-dasharray: 314.16;
  stroke-dashoffset: 314.16;
  transition: stroke-dashoffset 0.8s ease, stroke 0.4s ease;
}
.dial-score {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-weight: 600;
  font-size: 0.95rem;
}

.card-id { min-width: 0; flex: 1; }

.ticker-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.ticker { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }

.remove-btn {
  background: none;
  border: none;
  color: var(--text-dim);
  font-size: 1.2rem;
  line-height: 1;
  cursor: pointer;
  padding: 2px 6px;
}
.remove-btn:hover { color: var(--brick); }

.price { font-family: var(--font-mono); font-size: 0.95rem; color: var(--text); }

.overall-label { font-size: 0.78rem; color: var(--text-dim); margin-top: 2px; }
.overall-label.golden { color: var(--gold-bright); font-weight: 600; }
.overall-label.caution { color: var(--brick); font-weight: 600; }

.guidance-box {
  background: var(--surface-2);
  border-left: 3px solid var(--gold);
  border-radius: 0 8px 8px 0;
  padding: 10px 12px;
  margin: 12px 0;
  font-size: 0.82rem;
  line-height: 1.5;
  color: var(--text);
}

.earnings-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
}

.earnings-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-dim);
  border-radius: 6px;
  padding: 5px 10px;
  font-size: 0.75rem;
  cursor: pointer;
}
.earnings-btn:hover { border-color: var(--gold); color: var(--text); }
.earnings-btn:disabled { opacity: 0.5; cursor: default; }

.earnings-note {
  font-size: 0.68rem;
  color: var(--text-dim);
  font-style: italic;
}

.earnings-result {
  font-size: 0.78rem;
  color: var(--text-dim);
  margin-top: 6px;
}
.earnings-result.warn { color: var(--brick); font-weight: 600; }

.pe-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-dim);
  border-radius: 6px;
  padding: 5px 10px;
  font-size: 0.75rem;
  cursor: pointer;
}
.pe-btn:hover { border-color: var(--gold); color: var(--text); }
.pe-btn:disabled { opacity: 0.5; cursor: default; }

.pe-result {
  font-size: 0.78rem;
  color: var(--text-dim);
  margin-top: 6px;
}
.pe-result.warn { color: var(--brick); font-weight: 600; }

.sparkline-wrap { height: 54px; margin: 12px 0 8px; }

.tf-tabs {
  display: flex;
  gap: 6px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 10px;
}

.tf-tab {
  background: none;
  border: none;
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  padding: 6px 4px;
  cursor: pointer;
  border-bottom: 2px solid transparent;
}
.tf-tab.active { color: var(--gold); border-bottom-color: var(--gold); }

.tf-panel { font-size: 0.82rem; }

.metric-row { display: flex; justify-content: space-between; color: var(--text-dim); padding: 2px 0; }
.metric-row span:last-child { font-family: var(--font-mono); color: var(--text); }

.signal-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }

.chip {
  font-size: 0.72rem;
  padding: 3px 9px;
  border-radius: 20px;
  border: 1px solid var(--border);
  color: var(--text-dim);
}
.chip.bullish { border-color: var(--sage); color: var(--sage); }
.chip.caution { border-color: var(--brick); color: var(--brick); }
.chip.watch { border-color: var(--gold); color: var(--gold); }

.card-status { color: var(--text-dim); font-size: 0.85rem; padding: 20px 0; text-align: center; }

.ladder-section { margin: 10px 0; }

.ladder-title {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 600;
  margin: 10px 0 4px;
}
.ladder-title.resistance { color: var(--brick); }
.ladder-title.support { color: var(--sage); }

.ladder-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 0.78rem;
  margin-bottom: 2px;
}
.ladder-row.resistance { background: rgba(194, 91, 82, 0.08); }
.ladder-row.support { background: rgba(95, 163, 126, 0.08); }

.ladder-price {
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--text);
}
.ladder-row.resistance .ladder-price { color: var(--brick); }
.ladder-row.support .ladder-price { color: var(--sage); }

.ladder-label { color: var(--text-dim); font-size: 0.72rem; text-align: right; }

.ladder-empty { color: var(--text-dim); font-size: 0.75rem; font-style: italic; padding: 2px 8px; }

/* ---------- Footer ---------- */
.app-footer {
  max-width: 1160px;
  margin: 0 auto;
  padding: 0 20px 40px;
  color: var(--text-dim);
  font-size: 0.78rem;
  line-height: 1.5;
}

@media (prefers-reduced-motion: reduce) {
  .dial-arc { transition: none; }
  .stock-card { transition: none; }
}

@media (max-width: 480px) {
  .topbar { padding: 12px 14px; }
  .add-form { order: 3; max-width: none; flex-basis: 100%; }
  main { padding: 20px 14px 40px; }
}
